#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R     &kp T                      &kp Y  &kp U     &kp I      &kp O    &kp P     &kp DEL
&kp LCTRL  &kp A  &kp S  &kp D     &kp F     &kp G                      &kp H  &kp J     &kp K      &kp L    &kp MINUS &kp RGUI
&kp LSHFT  &kp LSHFT  &kp X  &kp C &kp V     &kp B                      &kp N  &kp M     &kp COMMA  &kp DOT  &kp RSHFT &kp RSHFT
&kp ESC    &kp LALT   &kp LGUI     &kp LCTRL &none    &none    &none  &none  &none      &kp LCTRL  &kp BSPC  &none     &none     &none
            >;
        };

        lower_layer {
            bindings = <
&none   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                    &kp N7   &kp N8   &kp N9   &kp N0   &kp N8    &none
&kp TAB &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                   &kp N4   &kp N5   &kp N6   &kp SEMI &kp MINUS &kp EQUAL
&none   &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                   &kp N1   &kp N2   &kp N3   &kp DOT  &kp FSLH  &kp EQUAL
&none   &none    &none    &none    &none    &none    &none  &kp DEL  &none    &none    &none    &none     &none     &none
            >;
        };

        raise_layer {
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                 &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &none
&none  &none   &none   &none   &none   &kp LSHFT              &none    &kp LBKT &kp RBKT &kp BSLH &kp SEMI &kp MINUS
&none  &none   &none   &none   &none   &none                  &kp SQT  &kp EQUAL &kp COMMA &kp DOT &kp FSLH &kp PIPE
&none  &none   &none   &trans  &trans  &mo 3   &none  &none   &none    &none    &none    &none    &none    &none
            >;
        };

        bt_layer {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &kp N7      &kp N8      &kp N9      &kp N0      &kp N8      &none
&studio_unlock  &none         &none         &none         &none         &none                       &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp HOME    &kp END
&none           &none         &none         &none         &none         &none                       &kp PG_UP   &kp PG_DN   &kp TAB     &kp TAB     &kp DEL     &none
&kp O           &kp M         &kp U         &none         &none         &none         &none  &none  &none  &none  &none  &kp K  &kp E  &kp N
            >;
        };

        media_layer {
            bindings = <
&kp C_PREV      &kp C_NEXT    &kp C_PP       &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE                &none  &none  &none  &none  &none  &none
&none           &none         &none          &none         &none         &none                      &none  &none  &none  &none  &none  &none
&none           &none         &none          &none         &none         &none                      &none  &none  &none  &none  &none  &none
&none           &none         &none          &none         &none         &none         &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        numpad_layer {
            bindings = <
&kp N7          &kp N8        &kp N9         &kp ASTRK     &kp FSLH      &none                      &none  &none  &none  &none  &none  &none
&kp N4          &kp N5        &kp N6         &kp MINUS     &kp PLUS      &none                      &none  &none  &none  &none  &none  &none
&kp N1          &kp N2        &kp N3         &kp EQUAL     &kp DOT       &none                      &none  &none  &none  &none  &none  &none
&kp N0          &kp N0        &kp DOT        &none         &none         &none         &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        symbol_layer {
            bindings = <
&kp TILDE       &kp GRAVE     &kp AT         &kp HASH      &kp DOLLAR    &kp PRCNT                 &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp MINUS
&kp EXCL        &kp AT        &kp HASH       &kp DOLLAR    &kp PRCNT     &kp CARET                 &kp AMPS   &kp ASTRK &kp LPAR   &kp RPAR  &kp UNDER &kp PLUS
&kp PIPE        &kp BSLH      &kp COLON      &kp SQT       &kp DQT       &kp LESS                  &kp GREATER &kp QMARK &kp EXCL   &kp EQUAL &kp PLUS  &kp PIPE
&none           &none         &none          &none         &none         &none         &none  &none  &none  &none  &none  &mo 7   &mo 8   &mo 9
            >;
        };

        function_layer {
            bindings = <
&kp F13         &kp F14       &kp F15        &kp F16       &kp F17       &kp F18                   &kp F19    &kp F20   &kp F21    &kp F22   &kp F23   &kp F24
&kp F1          &kp F2        &kp F3         &kp F4        &kp F5        &kp F6                    &kp F7     &kp F8    &kp F9     &kp F10   &kp F11   &kp F12
&kp F1          &kp F2        &kp F3         &kp F4        &kp F5        &kp F6                    &kp F7     &kp F8    &kp F9     &kp F10   &kp F11   &kp F12
&none           &none         &none          &none         &none         &none         &none  &none  &none  &none  &none  &mo 7   &mo 8   &mo 9
            >;
        };

        navigation_layer {
            bindings = <
&kp HOME        &kp END       &kp PG_UP      &kp PG_DN     &kp INS       &kp DEL                   &kp UP     &kp DOWN  &kp LEFT   &kp RIGHT &kp HOME  &kp END
&kp LCTRL       &kp LSHFT     &kp LALT       &kp LGUI      &kp RALT      &kp RSHFT                 &kp RCTRL  &kp RGUI  &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT
&kp LCTRL       &kp LSHFT     &kp LALT       &kp LGUI      &kp RALT      &kp RSHFT                 &kp RCTRL  &kp RGUI  &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT
&none           &none         &none          &none         &none         &none         &none  &none  &none  &none  &none  &mo 7   &mo 8   &mo 9
            >;
        };

        mouse_layer {
            bindings = <
&none           &none         &none          &none         &none         &none                     &none      &none     &none      &none     &none     &none
&none           &none         &none          &none         &none         &none                     &none      &none     &none      &none     &none     &none
&none           &none         &none          &none         &none         &none                     &none      &none     &none      &none     &none     &none
&none           &none         &none          &none         &none         &none         &none  &none  &none  &none  &none  &mo 7   &mo 8   &mo 9
            >;
        };

        macro_layer {
            bindings = <
&none           &none         &none          &none         &none         &none                     &none      &none     &none      &none     &none     &none
&none           &none         &none          &none         &none         &none                     &none      &none     &none      &none     &none     &none
&none           &none         &none          &none         &none         &none                     &none      &none     &none      &none     &none     &none
&none           &none         &none          &none         &none         &none         &none  &none  &none  &none  &none  &mo 7   &mo 8   &mo 9
            >;
        };

        gaming_layer {
            bindings = <
&kp Q           &kp W         &kp E          &kp R         &kp T         &kp Y                     &kp U      &kp I     &kp O      &kp P     &kp LBKT  &kp RBKT
&kp A           &kp S         &kp D          &kp F         &kp G         &kp H                     &kp J      &kp K     &kp L      &kp SEMI  &kp SQT   &kp BSLH
&kp Z           &kp X         &kp C          &kp V         &kp B         &kp N                     &kp M      &kp COMMA &kp DOT    &kp FSLH  &kp UP    &kp DOWN
&kp LSHFT       &kp LCTRL     &kp LALT       &kp LGUI      &kp SPACE    &kp SPACE                 &kp RET    &kp BSPC  &kp RGUI   &kp RALT  &kp RCTRL &kp RSHFT
            >;
        };
    };
};
